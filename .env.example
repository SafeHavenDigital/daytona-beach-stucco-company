# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — NEVER commit real keys. This file holds placeholders
# only and is safe to check in.
# ---------------------------------------------------------------------------

# Resend API key, used by src/pages/api/contact.ts to send contact-form
# submissions to the address in src/config/site.ts.
#
# Get one at https://resend.com/api-keys (a "Sending access" key is enough).
#
# Local dev reads this from .env.
#
# In production this must be a Cloudflare WORKER SECRET, not a Pages
# environment variable — this site deploys to Workers (see wrangler.jsonc).
# Set it once per environment:
#
#   npx wrangler secret put RESEND_API_KEY
#
# If it is missing, the contact form fails at runtime. Never put the real
# value in any file in this repo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
