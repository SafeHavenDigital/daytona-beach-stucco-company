# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — NEVER commit real keys. This file holds placeholders
# only and is safe to check in.
# ---------------------------------------------------------------------------

# Resend API key, used by src/pages/api/contact.ts to send contact-form
# submissions to the address in src/config/site.ts.
#
# Get one at https://resend.com/api-keys (a "Sending access" key is enough).
# Local dev reads this from .env. In production it must be set as an
# environment variable in the Cloudflare Pages project settings
# (Settings > Environment variables) — not in any file in this repo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
