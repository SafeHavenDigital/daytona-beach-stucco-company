---
/**
 * Breadcrumb trail. Ported from the Orlando Concrete Contractors interior-page
 * design (.crumbs), which opens every non-home page with Home > Section > Page.
 *
 * Renders on light grounds by default. Inside a .page-hero (dark), the hero's
 * own rules restyle it — no variant prop needed.
 *
 * SCHEMA: emits BreadcrumbList JSON-LD. `position` is 1-based and the last
 * item is the current page, which carries aria-current and NO link, matching
 * the reference. Pass `items` WITHOUT the Home entry — it is prepended here so
 * every page agrees on the root label.
 *
 * Paths must be real routes. This component does not validate them; a
 * breadcrumb pointing at a 404 is worse than no breadcrumb.
 */
export interface Crumb {
  href: string;
  label: string;
}

interface Props {
  /** Trail after Home, in order. The last entry is the current page. */
  items: Crumb[];
  /** Accessible label for the nav landmark. */
  label?: string;
}

const { items, label = 'Breadcrumb' } = Astro.props;

const trail: Crumb[] = [{ href: '/', label: 'Home' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: c.href,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav class="crumbs" aria-label={label}>
  <ol>
    {trail.map((c, i) => {
      const isLast = i === trail.length - 1;
      return (
        <li>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          {isLast ? (
            <span aria-current="page">{c.label}</span>
          ) : (
            <a href={c.href}>{c.label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
