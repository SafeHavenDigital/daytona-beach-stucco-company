---
/**
 * Shared footer.
 *
 * CREDENTIALS: `licenseNumber` and `insuranceCarrier` are null and the client
 * declined to supply them. Per brand/positioning.md they must never be
 * invented or stubbed. The "Licensed and insured" sentence is verified true
 * and may stand on its own; the number appends only if a real one is set.
 */
import { business, licenseNumber, serviceArea, email } from '../config/site';
---

<footer class="footer">
  <div class="wrap">
    <p class="foot-name">{business.name}</p>

    <p class="foot-line">
      Stucco repair and installation. Serving Daytona Beach and Volusia County.
    </p>

    <nav class="foot-nav" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/stucco-repair/">Stucco repair</a>
      <a href="/stucco-repair/#pricing">What stucco repair costs</a>
      {/* "Stucco repair in Daytona Beach" removed 2026-08-30 — that URL now
          301s to /stucco-repair/, already linked above. */}
      <a href="/blog/why-stucco-cracks-come-back/">Why stucco cracks come back</a>
      <a href="/contact/">Contact</a>
    </nav>

    <p class="foot-line">
      Licensed and insured{licenseNumber ? ` — License ${licenseNumber}` : ''}.
      Founded {business.founded}.
    </p>

    {email && (
      <p class="foot-line">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    )}

    {serviceArea && <p class="foot-line">{serviceArea.join(' · ')}</p>}
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem;
    background: var(--paper-warm);
  }

  .foot-name { font-weight: 650; margin-bottom: 0.5rem; }

  .foot-line {
    margin: 0 0 0.375rem;
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1rem 0 1.25rem;
  }

  .foot-nav a { font-size: 0.9375rem; text-decoration: none; }

  .foot-nav a:hover { text-decoration: underline; }
</style>
