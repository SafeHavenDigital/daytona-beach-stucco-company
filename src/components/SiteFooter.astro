---
/**
 * Shared footer.
 *
 * CREDENTIALS: `licenseNumber` and `insuranceCarrier` are null and the client
 * declined to supply them. Per brand/positioning.md they must never be
 * invented or stubbed. The "Licensed and insured" sentence is verified true
 * and may stand on its own; the number appends only if a real one is set.
 *
 * VISUAL SYSTEM (2026-09-01): ported from the Orlando Concrete Contractors
 * reference. Dark band (.on-dark), a brand column plus link columns, then a
 * hairline-separated bottom bar.
 *
 * Two deliberate departures from the reference, both forced by verified facts:
 *
 *   1. NO legal-link row. The reference links /privacy-policy/, /terms/ and
 *      /accessibility/. None of those routes exist here, and shipping three
 *      404s in the sitewide footer is worse than omitting the row. Add it
 *      when the pages exist.
 *   2. NO hours block. `phone` is null and business hours are listed as
 *      OUTSTANDING in src/config/site.ts. Every contact line below is
 *      conditional on a verified value, so nothing renders as a placeholder.
 *
 * Link content is unchanged from the pre-redesign footer — the same
 * destinations, regrouped into columns. The "no waterproofing, no spalling"
 * rule below still holds: both are verified-FALSE in verifiedServices and
 * must never appear in navigation.
 */
import {
  business,
  licenseNumber,
  serviceArea,
  email,
  phone,
} from '../config/site';

const services = [
  { href: '/stucco-water-damage-repair/', label: 'Water damage repair' },
  { href: '/eifs-repair/', label: 'EIFS repair' },
  { href: '/stucco-resurfacing/', label: 'Resurfacing' },
  { href: '/stucco-replacement/', label: 'Replacement' },
  { href: '/new-stucco-installation/', label: 'New installation' },
  { href: '/stucco-painting/', label: 'Painting' },
  { href: '/stucco-repair-around-windows/', label: 'Around windows' },
  { href: '/stucco-chimney-repair/', label: 'Chimney repair' },
  { href: '/stucco-soffit-and-band-repair/', label: 'Soffit & band repair' },
  { href: '/commercial-stucco/', label: 'Commercial stucco' },
];

const problems = [
  { href: '/problems/cracks-in-stucco/', label: 'Cracks in stucco' },
  { href: '/problems/water-stains-on-stucco/', label: 'Water stains' },
  { href: '/problems/soft-spots-hollow-stucco/', label: 'Soft or hollow spots' },
  { href: '/problems/bubbling-peeling-paint-stucco/', label: 'Bubbling or peeling paint' },
  { href: '/problems/hurricane-storm-stucco-damage/', label: 'Storm damage' },
];

const guides = [
  { href: '/stucco-repair/', label: 'Stucco repair' },
  { href: '/stucco-repair/#pricing', label: 'What stucco repair costs' },
  { href: '/stucco-crack-triage/', label: 'When to worry' },
  { href: '/stucco-moisture-testing/', label: 'Moisture testing' },
  { href: '/process/', label: 'Our process' },
  { href: '/blog/why-stucco-cracks-come-back/', label: 'Why stucco cracks come back' },
  { href: '/blog/is-stucco-supposed-to-get-wet/', label: 'Is stucco supposed to get wet?' },
  { href: '/about/', label: 'About' },
];

const telHref = phone ? `tel:${phone.replace(/[^0-9+]/g, '')}` : null;
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="foot-main">
    <div class="foot-brand">
      <a class="mark" href="/">
        <span class="mark-name">{business.name}</span>
        <span class="mark-place">Daytona Beach · Florida</span>
      </a>

      <p class="foot-blurb">
        Stucco repair and installation. Serving Daytona Beach and Volusia County.
      </p>

      <a class="btn btn-primary" href="/contact/">Request an estimate</a>
    </div>

    <nav class="foot-col" aria-label="Services">
      <h2>Services</h2>
      <ul>
        {services.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="col-all" href="/services/">All services <span aria-hidden="true">&rarr;</span></a>
    </nav>

    <nav class="foot-col" aria-label="Stucco problems">
      <h2>Stucco Problems</h2>
      <ul>
        {problems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="col-all" href="/problems/">All problems <span aria-hidden="true">&rarr;</span></a>
    </nav>

    <nav class="foot-col" aria-label="Guides">
      <h2>Guides</h2>
      <ul>
        {guides.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot-col">
      <h2>Contact</h2>
      <ul class="contact-list">
        {phone && telHref && (
          <li>
            <span class="c-label">Phone</span>
            <a class="c-value c-strong" href={telHref}>{phone}</a>
          </li>
        )}
        {email && (
          <li>
            <span class="c-label">Email</span>
            <a class="c-value" href={`mailto:${email}`}>{email}</a>
          </li>
        )}
        {serviceArea && (
          <li>
            <span class="c-label">Serving</span>
            <span class="c-value">{serviceArea.join(' · ')}</span>
          </li>
        )}
        <li>
          <span class="c-label">Credentials</span>
          <span class="c-value">
            Licensed and insured{licenseNumber ? ` — License ${licenseNumber}` : ''}
          </span>
        </li>
        <li>
          <span class="c-label">Founded</span>
          <span class="c-value">{business.founded}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="foot-bottom">
    <div class="bottom-inner">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--shell-rule); }

  .foot-main {
    display: grid;
    gap: 2.75rem;
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding: 3rem var(--gutter);
  }

  /* --- Brand column --------------------------------------------------- */
  .mark {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1rem;
    text-decoration: none;
    color: var(--shell-ink);
  }

  .mark-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .mark-place {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--shell-ink-soft);
  }

  .foot-blurb {
    margin: 0 0 1.5rem;
    max-width: 20rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--shell-ink-soft);
  }

  /* --- Link columns ---------------------------------------------------
   * Heading is a mono label over a hairline, matching the reference. */
  .foot-col h2 {
    margin: 0 0 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--shell-rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--shell-ink-soft);
  }

  .foot-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .foot-col a {
    display: inline-block;
    padding-block: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
    color: var(--shell-ink-soft);
  }

  .foot-col a:hover { color: var(--shell-ink); }

  .col-all {
    font-family: var(--font-display);
    font-weight: 700;
    border-bottom: 2px solid transparent;
  }

  .col-all:hover { border-bottom-color: var(--accent); }

  /* --- Contact list ---------------------------------------------------- */
  .contact-list { gap: 0.75rem; }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .c-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #71717a;
  }

  .c-value {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--shell-ink-soft);
  }

  a.c-value { padding-block: 0.25rem; }

  .c-strong {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* --- Bottom bar ------------------------------------------------------ */
  .foot-bottom {
    border-top: 1px solid var(--shell-rule);
    padding-block: 1.5rem;
  }

  .bottom-inner {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .bottom-inner p {
    margin: 0;
    max-width: none;
    font-size: 0.875rem;
    color: #71717a;
  }

  @media (min-width: 48rem) {
    .foot-main {
      grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
      padding-block: 4.5rem;
    }
  }
</style>
