---
/**
 * FAQ accordion. Ported from the Orlando `.faq` block: hairline-separated
 * <details> rows with a plus/minus sign that rotates to a minus when open.
 *
 * NATIVE <details>, deliberately — it works with JavaScript disabled, is
 * keyboard-operable for free, and is findable by in-page browser search when
 * open. The reference does the same.
 *
 * SCHEMA is NOT emitted here. Every page that has FAQs already builds its own
 * FAQPage JSON-LD from the same array, and two FAQPage blocks on one page is
 * a markup error. Keep the schema in the page; pass the same array in here.
 *
 * `open` opens the first item on load — off by default so the block stays
 * compact, which is what the reference does.
 */
interface QA {
  q: string;
  a: string;
}

interface Props {
  items: QA[];
  /** Open the first entry on load. */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {items.map((item, i) => (
    <details class="faq-item" open={openFirst && i === 0}>
      <summary class="faq-q">
        {item.q}
        <span class="faq-sign" aria-hidden="true"></span>
      </summary>
      <div class="faq-a">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--rule); }

  .faq-item { border-bottom: 1px solid var(--rule); }

  .faq-q {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.012em;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker { display: none; }

  .faq-q:hover { color: var(--accent); }

  /* Plus that loses its vertical stroke when the row opens. */
  .faq-sign {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
  }

  .faq-sign::before,
  .faq-sign::after {
    content: '';
    position: absolute;
    background: var(--accent);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .faq-sign::before {
    inset: 50% 0 auto;
    height: 2px;
    transform: translateY(-50%);
  }

  .faq-sign::after {
    inset: 0 auto 0 50%;
    width: 2px;
    transform: translateX(-50%);
  }

  .faq-item[open] .faq-sign::after {
    opacity: 0;
    transform: translateX(-50%) rotate(90deg);
  }

  .faq-a { padding-bottom: 2rem; }

  .faq-a p {
    margin: 0;
    max-width: 64ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  @media (min-width: 40rem) {
    .faq-q { padding: 2rem 0; font-size: 1.1875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-sign::before,
    .faq-sign::after { transition: none; }
  }
</style>
