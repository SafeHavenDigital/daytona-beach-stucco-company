const title = 'Is Stucco Supposed to Get Wet? | Daytona Beach Stucco';
const description =
  'Stucco is not waterproof, and it was never meant to be. How a stucco wall is designed to get wet and dry out — and why that depends on which wall you have.';

const published = '2026-09-01';

const canonical = Astro.site
  ? new URL('/blog/is-stucco-supposed-to-get-wet/', Astro.site).toString()
  : '/blog/is-stucco-supposed-to-get-wet/';

/**
 * The two wall systems. This table IS the article's differentiator — no
 * ranking competitor makes the distinction, and getting it wrong is how a
 * homeowner ends up sealing a wall that needed to breathe.
 */
const systems = [
  {
    name: 'Concrete block, stucco applied directly',
    common: 'Most Florida coastal housing',
    how: 'A barrier system, sometimes called face-sealed. There is no gap behind the stucco, because the stucco is bonded straight to the block. The wall resists water at its face and dries in both directions.',
    weep: 'No drainage cavity, so no code-required weep screed — and one would have nothing to drain if it were fitted.',
  },
  {
    name: 'Wood frame, lath over a barrier',
    common: 'Additions, framed second storeys, some newer builds',
    how: 'A drainage system. Lath holds the stucco slightly off a water-resistive barrier, leaving a path. Water that gets through the stucco runs down that barrier instead of reaching the framing.',
    weep: 'Needs a weep screed at the base to let that water out. This is the wall the building code is written about.',
  },
];

const faqs = [
  {
    q: 'Is stucco waterproof?',
    a: 'No. Stucco is water-resistant, not waterproof, and it was never designed to be waterproof. It is a porous cement product that takes on water when it rains and gives it back up as it dries. A wall that gets wet in a storm and dries out afterwards is a wall doing exactly what it was built to do.',
  },
  {
    q: 'Does stucco absorb water?',
    a: 'Yes, by design. Stucco is sometimes called a reservoir cladding because it holds rainwater in its own thickness and releases it later by evaporation. The problem is never that stucco got wet. The problem is when it cannot dry, or when water gets past it to something that rots or rusts.',
  },
  {
    q: 'What is a weep screed, and does my house have one?',
    a: 'It is a metal flashing at the base of a stucco wall that gives trapped water a way out. It belongs on wood-framed stucco walls, where the code calls for it to sit not less than four inches above earth or two inches above paved surfaces. Stucco applied directly to concrete block has no drainage cavity behind it, so it generally has no weep screed and does not need one.',
  },
  {
    q: 'What happens if the weep screed is buried?',
    a: 'On a framed wall, burying it closes the only exit the wall has. Soil, mulch, a raised patio or a poured slab against the base of the wall can all do it, and the result is water held in the assembly with nowhere to go. Staining, rusted lath, soft sheathing and cracking low on the wall are the usual signs.',
  },
  {
    q: 'Should I seal or waterproof my stucco?',
    a: 'Be careful here, because the advice you find is mostly written by companies selling coatings. Stucco needs to release water vapour. A coating that is not vapour-permeable can hold moisture inside the wall rather than keeping it out, and that does more damage than the water it was meant to stop. If a wall is being coated, permeability is the property that matters.',
  },
  {
    q: 'When is a wet stucco wall actually a problem?',
    a: 'When it stays wet. Wet after rain and dry a day later is normal. Damp that persists in dry weather, a patch that is always darker than the wall around it, chalky white deposits, bubbling paint or a hollow or soft area all suggest water is getting in and not leaving.',
  },
];

const articleSchema = {
