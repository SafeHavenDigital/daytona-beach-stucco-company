---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactCta from '../components/ContactCta.astro';
import {
  business,
  moistureCheck,
  phone,
  serviceArea,
  openWallPhotos,
  whatMovesThePrice,
} from '../config/site';

/**
 * HOMEPAGE — the company entity page.
 *
 * Per brand/keyword-plan.md architecture rule 1c (2026-08-30): this page
 * represents Daytona Beach Stucco Company and the broader verified service
 * offering. It is NOT a stucco repair landing page and must not compete with
 * /stucco-repair/ for repair intent.
 *
 * It targets contractor/company entity queries — "stucco contractor daytona
 * beach", "stucco company daytona beach" — and links out to each authoritative
 * service page. Repair, cost, and geo intent all belong to /stucco-repair/.
 */
const title = 'Daytona Beach Stucco Company | Stucco Contractor in Volusia County';
const description =
  'Daytona Beach Stucco Company is a licensed and insured stucco contractor serving Daytona Beach and Volusia County. Repair, water damage, moisture diagnostics, and re-stucco. Free repair estimates.';

/**
 * LocalBusiness schema. Fields are added only when verified — `telephone`,
 * `areaServed`, and review data stay out of the payload entirely until the
 * client supplies them. Emitting a placeholder here would publish a false
 * fact to Google, which is worse than omitting it.
 */
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.name,
  description,
  foundingDate: String(business.founded),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: moistureCheck.name,
      description:
        'A paid diagnostic service. Visual examination for signs of possible water intrusion, moisture meter testing for possible hidden moisture behind the stucco, and thermal imaging when appropriate.',
    },
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: moistureCheck.priceLow,
      maxPrice: moistureCheck.priceHigh,
      priceCurrency: 'USD',
    },
  },
};
if (phone) schema.telephone = phone;
if (serviceArea) schema.areaServed = serviceArea;
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <SiteHeader current="/" />

  <main>
    {/* HERO */}
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Daytona Beach &amp; Volusia County</p>
        <h1>{business.name}</h1>
        <p class="hero-lede">
          A stucco contractor working Daytona Beach and Volusia County since
          {' '}{business.founded}. We find out why a wall failed before we close
          it up &mdash; which is why our repairs don&rsquo;t come back.
        </p>

        <div class="hero-actions">
          <ContactCta variant="inline" heading="" />
        </div>
      </div>
    </section>

    {/* WHAT WE DO — the services index. This is the homepage's core job. */}
    <section class="section" id="services">
      <div class="wrap">
        <h2>What we do</h2>

        <p>
          Stucco work on houses and buildings across Daytona Beach and Volusia
          County &mdash; repair, water damage, diagnostics, and full re-stucco.
        </p>

        <ul class="links">
          <li>
            <a href="/stucco-repair/">Stucco repair</a> &mdash; cracks,
            patching, water damage, re-stucco, and texture matching. How we
            decide which one you actually need, what it costs in this area, and
            why three quotes came back three different numbers.
          </li>
          <li>
            <a href="/stucco-repair/#moisture-check">The {moistureCheck.name}</a>
            {' '}&mdash; a separate paid diagnostic service. We check for
            moisture behind the wall before anyone quotes a repair.
          </li>
          <li>
            <a href="/blog/why-stucco-cracks-come-back/">
              Why stucco cracks come back
            </a>
            {' '}&mdash; the long version of what goes wrong when a repair
            fixes the surface instead of the cause.
          </li>
        </ul>
      </div>
    </section>

    {/* POSITIONING — the argument in short. The full version lives on
        /stucco-repair/; this is the summary that earns the click. */}
    <section class="section band" id="how-we-work">
      <div class="wrap">
        <h2>How we work</h2>

        <p class="band-lede">
          Most stucco repairs fail because nobody looked behind the wall.
        </p>

        <p>
          A crack gets filled, sanded, and painted. It looks right for a season,
          then opens again in the same place.
          <strong>
            That&rsquo;s because the crack was never the problem &mdash; it was
            the evidence.
          </strong>
          When water gets behind stucco it doesn&rsquo;t dry out on its own, and
          patching the surface seals it in.
        </p>

        <p>
          Not every crack means water. Hairline cracking is normal in Florida.
          <strong>
            Some of what I look at is cosmetic, and I&rsquo;ll tell you when it
            is.
          </strong>
          {' '}But you can&rsquo;t tell which is which from the outside, and
          that&rsquo;s the whole reason the first repair failed.
        </p>

        <p>
          <a href="/stucco-repair/">
            More on how we approach a repair and what it costs
          </a>
        </p>
      </div>
    </section>

    {/*
      THE MOISTURE CHECK — REDUCED TO A SUMMARY (2026-08-30).

      Phase 10 step 6: the full block (3 steps + 5 deliverables + caveat)
      previously rendered here, on /stucco-repair/, and on the now-retired
      /stucco-repair-daytona-beach/. Three full copies of the same content.

      This is now a summary linking to /stucco-repair/#moisture-check, which
      holds the full detail today. When /stucco-moisture-testing/ is built, the
      full block moves there and /stucco-repair/ reduces to a summary too — at
      that point this link should be repointed to the new page.

      The price and the free-estimate separation stay stated here: per
      positioning.md that separation is a hard constraint wherever the Check is
      mentioned, and a summary must not blur it.
    */}
    <section class="section" id="moisture-check">
      <div class="wrap">
        <p class="eyebrow">A paid diagnostic service</p>
        <h2>The {moistureCheck.name}</h2>

        <p>
          Before anyone quotes you a repair, it&rsquo;s worth knowing whether
          there&rsquo;s moisture behind the wall. That&rsquo;s a separate piece
          of work from the repair, and it&rsquo;s what the
          {' '}{moistureCheck.name} is: a visual examination, moisture meter
          testing, and thermal imaging when it&rsquo;s appropriate. You get the
          findings, the readings, and what we&rsquo;d do next &mdash; whether or
          not you ever hire us.
        </p>

        <p>
          It costs ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}
          {' '}and is <strong>not</strong> included in the free repair estimate.
        </p>

        <p>
          <a href="/stucco-repair/#moisture-check">
            The full process, what you get, and what it costs
          </a>
        </p>
      </div>
    </section>

    {/* PRICING */}
    <section class="section band" id="pricing">
      <div class="wrap">
        <h2>What it costs</h2>

        <div class="prices">
          <div class="price-card">
            <p class="price-label">Repair estimate</p>
            <p class="price-figure">Free</p>
            <p class="price-body">
              If you know what you need done, I&rsquo;ll come look at it and give
              you a number for the work. No charge for that.
            </p>
          </div>

          <div class="price-card featured">
            <p class="price-label">{moistureCheck.name}</p>
            <p class="price-figure">
              ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}
            </p>
            <p class="price-body">
              {whatMovesThePrice
                ? whatMovesThePrice
                : `A paid diagnostic service, priced ${moistureCheck.priceNote}.`}
            </p>
          </div>
        </div>

        <div class="separation">
          <h3>These are two different things, and I&rsquo;ll be plain about it</h3>
          <p>
            The estimate is free. The {moistureCheck.name} is not &mdash; it&rsquo;s
            ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}, paid on its
            own. <strong>It isn&rsquo;t credited toward repair work if you hire
            us.</strong> If we do the repair, that&rsquo;s quoted and paid
            separately.
          </p>
          <p>
            I charge for it for a reason. Because the fee isn&rsquo;t tied to
            winning your repair job, I get paid the same whether the answer is
            &ldquo;there&rsquo;s water in this wall&rdquo; or &ldquo;this is
            cosmetic, leave it alone.&rdquo;
            <strong>
              Nobody here has a reason to find you an expensive problem.
            </strong>
          </p>
        </div>
      </div>
    </section>

    {/*
      SERVICE AREA. The old "More on the work" list lived here and duplicated
      the services index above, including a link to the retired
      /stucco-repair-daytona-beach/. Replaced 2026-08-30 with the area
      statement, which is what this slot is actually for on an entity page.
    */}
    <section class="section" id="area">
      <div class="wrap">
        <h2>Where we work</h2>
        <p>
          Daytona Beach and the surrounding Volusia County area. Wind-driven
          rain off the Atlantic does most of the damage here, and it doesn&rsquo;t
          arrive straight down &mdash; which is why the failures cluster around
          window corners, rooflines, and dried-out control joints.
          {' '}<a href="/stucco-repair/#what-we-see">
            What we see most on houses here
          </a>{' '}goes through the patterns in detail.
        </p>
      </div>
    </section>

    {/* CONTACT */}
    <section class="section" id="contact-form">
      <div class="wrap">
        <ContactCta />
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6rem);
    background:
      linear-gradient(180deg, var(--paper-warm), var(--paper));
    border-bottom: 1px solid var(--rule);
  }
  .hero h1 { max-width: 20ch; }
  .hero-lede {
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
    color: var(--ink-soft);
    max-width: 40ch;
    margin-top: 1.25rem;
  }
  .hero-actions { margin-top: 2rem; }

  .band { background: var(--paper-warm); border-block: 1px solid var(--rule); }
  .band-lede { max-width: 42ch; color: var(--ink-soft); }

  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .steps p { margin: 0; max-width: 46ch; color: var(--ink-soft); }
  .num {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.9375rem;
    font-weight: 650;
  }

  .caveat {
    margin-top: 2rem;
    padding-left: 1rem;
    border-left: 3px solid var(--sand);
    color: var(--ink-faint);
    font-size: 0.9375rem;
    max-width: 46ch;
  }

  .deliverable {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.625rem;
    max-width: 36rem;
  }
  .deliverable li {
    padding-left: 1.75rem;
    position: relative;
  }
  .deliverable li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .links {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }
  .links li { color: var(--ink-soft); }
  .links a { font-weight: 600; }

  .note {
    font-size: 0.9375rem;
    color: var(--ink-faint);
    max-width: 44ch;
  }

  .proof {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-top: 2rem;
  }
  .proof img { width: 100%; border-radius: 10px; display: block; }

  .prices {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: 2rem 0;
    max-width: 46rem;
  }
  .price-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .price-card.featured { border-color: var(--accent); border-width: 1.5px; }
  .price-label {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 650;
  }
  .price-figure {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 680;
    letter-spacing: -0.03em;
  }
  .price-body { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); }

  .separation {
    background: var(--paper);
    border-left: 3px solid var(--flag);
    border-radius: 0 10px 10px 0;
    padding: 1.5rem;
    max-width: 46rem;
  }
  .separation h3 { margin-bottom: 0.75rem; }
  .separation p:last-child { margin-bottom: 0; }
</style>
