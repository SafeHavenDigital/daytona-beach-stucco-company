---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import ContactCta from '../components/ContactCta.astro';
import LeadForm from '../components/LeadForm.astro';
import {
  business,
  moistureCheck,
  phone,
  serviceArea,
  serviceAreaProse,
  openWallPhotos,
  whatMovesThePrice,
  repairPriceRanges,
  repairPerSquareFoot,
  pricingDisclaimer,
} from '../config/site';

/**
 * HOMEPAGE — the company entity page.
 *
 * Per brand/keyword-plan.md architecture rule 1c (2026-08-30): this page
 * represents Daytona Beach Stucco Company and the broader verified service
 * offering. It is NOT a stucco repair landing page and must not compete with
 * /stucco-repair/ for repair intent.
 *
 * It targets contractor/company entity queries — "stucco contractor daytona
 * beach", "stucco company daytona beach" — and links out to each authoritative
 * service page. Repair, cost, and geo intent all belong to /stucco-repair/.
 *
 * VISUAL SYSTEM (2026-09-01): section structure ported from the Orlando
 * Concrete Contractors reference — dark hero with a two-column copy/form
 * split, a hairline capability strip beneath it, then alternating light and
 * dark bands, ending on a dark final CTA. All copy, links, headings, prices,
 * and schema below are the pre-existing Daytona content, unchanged. Only the
 * markup around them moved.
 *
 * The reference's hero carries a background photograph. We have no real
 * photography and brand/creative-kit.md forbids fabricating job imagery, so
 * the hero is a flat --shell ground. Drop a real photo in later.
 */
const title = 'Daytona Beach Stucco Company | Stucco Contractor in Volusia County';
const description =
  'Daytona Beach Stucco Company is a licensed and insured stucco contractor serving Daytona Beach and Volusia County. Repair, water damage, moisture diagnostics, and re-stucco. Free repair estimates.';

/**
 * The hairline capability strip under the hero. Mirrors the reference's
 * four-cell list. Every entry is a verified service with a live page.
 */
const capabilities = ['Repair', 'Water damage', 'Diagnostics', 'Re-stucco'];

/**
 * PRICING EXCERPT (2026-09-02).
 *
 * CANNIBALIZATION GUARD — read before widening this.
 * `/stucco-repair/#pricing` is the authoritative cost asset (keyword-plan.md
 * architecture rule 1b; the COST/ESTIMATE/QUOTE group routes there and to no
 * other URL). The homepage must NOT reproduce it. positioning.md names
 * published ranges as white space, so showing nothing here forfeits the
 * differentiator — but showing all nine rows would build a second cost page
 * at `/`, which rule 1c forbids.
 *
 * The resolution: FOUR rows, taken from the existing array by index so they
 * cannot drift from the source, plus the mandatory disclaimer, plus a link out.
 * Four spans the actual range (a $250 low to a $7,000+ open end) which is the
 * differentiating fact, without reproducing the table.
 *
 * DO NOT rewrite these strings. They render from `repairPriceRanges` verbatim.
 * DO NOT drop `pricingDisclaimer` — site.ts marks it MANDATORY wherever a
 * range renders, because these are researched market ranges for the area and
 * NOT this company's quotes.
 */
const priceExcerpt = [
  repairPriceRanges[0], // Minor crack repair — the floor
  repairPriceRanges[4], // Water-damaged stucco repair — the positioning case
  repairPriceRanges[6], // Large wall section or partial replacement
  repairPriceRanges[8], // Full resurfacing — the open-ended ceiling
];

const money = (n: number) => `$${n.toLocaleString('en-US')}`;

/**
 * PROOF STRIP (2026-09-02).
 *
 * voice-profile.md:229 — "Front-load proof that exists — and omit the rest."
 * Revised 2026-09-01: where a fact is null, OMIT the element; never stub it.
 *
 * So this array is BUILT, not written. Each entry is conditional on a verified
 * constant in src/config/site.ts. `reviewCount`, `rating`, `warrantyTerms`,
 * `openWallPhotos`, `licenseNumber` and `phone` are all null, so the cells that
 * would carry them simply do not exist here. When the client supplies one, add
 * its cell — do not add the cell first and fill it later.
 *
 * `business.founded` renders as "Since 2018". It is a START DATE and nothing
 * more: no computed duration, no years-of-experience claim. See site.ts.
 */
const proofPoints: { label: string; value: string }[] = [];

if (business.founded) {
  proofPoints.push({
    label: 'Working here',
    value: `Since ${business.founded}`,
  });
}

if (business.licensedAndInsured) {
  proofPoints.push({
    label: 'Credentials',
    value: 'Licensed and insured',
  });
}

if (serviceArea && serviceArea.length) {
  proofPoints.push({
    label: 'Service area',
    value: serviceArea.join(' and '),
  });
}

proofPoints.push({
  label: 'Diagnostics',
  value: moistureCheck.name,
});

/**
 * LocalBusiness schema. Fields are added only when verified — `telephone`,
 * `areaServed`, and review data stay out of the payload entirely until the
 * client supplies them. Emitting a placeholder here would publish a false
 * fact to Google, which is worse than omitting it.
 */
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.name,
  description,
  foundingDate: String(business.founded),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: moistureCheck.name,
      description:
        'A paid diagnostic service. Visual examination for signs of possible water intrusion, moisture meter testing for possible hidden moisture behind the stucco, and thermal imaging when appropriate.',
    },
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: moistureCheck.priceLow,
      maxPrice: moistureCheck.priceHigh,
      priceCurrency: 'USD',
    },
  },
};
if (phone) schema.telephone = phone;
if (serviceArea) schema.areaServed = serviceArea;
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <SiteHeader current="/" />

  <main id="main">
    {/*
      HERO — dark band, two columns. Copy left, the contact panel right,
      matching the reference's 1.15fr / 0.85fr split. The form itself is the
      existing ContactCta in `inline` variant; its behavior is untouched.
    */}
    <section class="hero on-dark">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Daytona Beach &amp; Volusia County</p>

          <h1>{business.name}</h1>

          <p class="hero-lede">
            A stucco contractor working Daytona Beach and Volusia County since
            {' '}{business.founded}. We find out why a wall failed before we close
            it up &mdash; which is why our repairs don&rsquo;t come back.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="/contact/">Request an estimate</a>
            <a class="btn btn-secondary" href="/stucco-repair/">
              Stucco repair &amp; costs
            </a>
          </div>

          {/*
            NOT "send a photo" — /api/contact posts JSON and forwards no
            attachments, and the form at /contact/ deliberately has no file
            input (see the note in src/pages/contact/index.astro). Photos are
            requested by email reply instead. A CTA promising an upload the
            form cannot accept would be a false claim about our own
            functionality. Revisit if attachment handling is ever built.
          */}
          <p class="hero-note">
            Tell us what you&rsquo;re looking at and we&rsquo;ll tell you what
            it is. Free repair estimates.
          </p>

          <ul class="capabilities">
            {capabilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <aside class="hero-panel" aria-label="Contact Daytona Beach Stucco Company">
          <LeadForm />
        </aside>
      </div>
    </section>

    {/*
      PROOF STRIP (2026-09-02). Renders only cells built from verified
      constants — see `proofPoints` in the frontmatter. It carries the
      "licensed and insured" line that used to sit under the hero CTAs, where
      positioning.md:292 says a saturated claim must not lead. True, worth
      stating, wrong place. Here it sits among other facts instead of standing
      in for a differentiator.
    */}
    {proofPoints.length > 0 && (
      <section class="section proof-strip band" aria-label="About the company">
        <div class="wrap">
          <ul class="proof grid-hairline">
            {proofPoints.map((item) => (
              <li>
                <span class="proof-label">{item.label}</span>
                <span class="proof-value">{item.value}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/*
      DISTRESS-STATE ROUTER (2026-09-02).

      voice-profile.md:226 — "Name the distress state out loud." The audience
      is problem-aware / solution-unaware (audience.md:118): they know the wall
      is wrong but not what service fixes it. This section does the naming and
      hands each state to the page that already answers it.

      EVERY href here is a live route, verified 2026-09-02. This block invents
      no content — it is pure routing to pages that already exist. Do not add a
      state without a page to send it to; a state named and then unanswered is
      worse than one left out.
    */}
    <section class="section triage" id="start-here">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">Start here</p>
          <h2>Which one of these is you?</h2>
          <p class="section-lede">
            If one of these sounds like your situation, start there &mdash;
            each one goes to what we&rsquo;ve written about it.
          </p>
        </header>

        <div class="states grid-hairline">
          <a class="state" href="/problems/cracks-in-stucco/">
            <h3>There are cracks and we don&rsquo;t know if they matter</h3>
            <p>Which cracks are cosmetic, which ones aren&rsquo;t, and how to tell them apart.</p>
          </a>

          <a class="state" href="/problems/water-stains-on-stucco/">
            <h3>There&rsquo;s a stain, and it keeps coming back</h3>
            <p>What a stain on stucco usually means about what is happening behind it.</p>
          </a>

          <a class="state" href="/problems/soft-spots-hollow-stucco/">
            <h3>A spot sounds hollow or gives when we press it</h3>
            <p>Stucco that has come loose from the wall behind it, and what that means.</p>
          </a>

          <a class="state" href="/problems/bubbling-peeling-paint-stucco/">
            <h3>The paint is bubbling or peeling off</h3>
            <p>Why paint lifts off stucco, and why repainting it usually doesn&rsquo;t hold.</p>
          </a>

          <a class="state" href="/problems/hurricane-storm-stucco-damage/">
            <h3>A storm came through</h3>
            <p>What to look for on the walls after wind-driven rain, and what to document.</p>
          </a>

          <a class="state" href="/stucco-crack-triage/">
            <h3>We just want to know whether to worry</h3>
            <p>A walk through what you&rsquo;re looking at, ending in a plain answer.</p>
          </a>
        </div>

        <p class="states-more">
          <a class="more" href="/problems/">Every stucco problem we write about</a>
        </p>
      </div>
    </section>

    {/* WHAT WE DO — the services index. This is the homepage's core job. */}
    <section class="section" id="services">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">What we do</p>
          <h2>Stucco work across Daytona Beach and Volusia County</h2>
          <p class="section-lede">
            Stucco work on houses and buildings across Daytona Beach and Volusia
            County &mdash; repair, water damage, diagnostics, and full re-stucco.
          </p>
        </header>

        <div class="cards grid-hairline">
        <a class="card" href="/stucco-repair/">
          <h3>Stucco Repair &amp; Costs</h3>
          <p>
            Cracks, patching, water damage, re-stucco, and texture matching.
            How we decide which repair you actually need and what affects cost.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-water-damage-repair/">
          <h3>Stucco Water Damage Repair</h3>
          <p>
            Repair for stucco affected by water intrusion and damaged exterior wall areas.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/eifs-repair/">
          <h3>EIFS Repair</h3>
          <p>
            Repair for damaged or failing EIFS exterior wall systems.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-resurfacing/">
          <h3>Stucco Resurfacing</h3>
          <p>
            Resurfacing for worn or deteriorated stucco that needs a renewed exterior finish.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-replacement/">
          <h3>Stucco Replacement</h3>
          <p>
            Replacement for stucco sections where repair alone is not the right solution.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/new-stucco-installation/">
          <h3>New Stucco Installation</h3>
          <p>
            New stucco installation for exterior wall areas and new construction work.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-painting/">
          <h3>Stucco Painting</h3>
          <p>
            Painting for exterior stucco surfaces that need a refreshed finish.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-repair-around-windows/">
          <h3>Stucco Repair Around Windows</h3>
          <p>
            Targeted repair where stucco damage or moisture concerns occur around windows.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-chimney-repair/">
          <h3>Stucco Chimney Repair</h3>
          <p>
            Repair for cracked, deteriorated, or damaged stucco around chimney exteriors.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-soffit-and-band-repair/">
          <h3>Soffit &amp; Band Repair</h3>
          <p>
            Stucco repair for soffits, decorative bands, and related exterior trim areas.
          </p>
          <span class="card-go">View service</span>
        </a>

        <a class="card" href="/stucco-moisture-testing/">
          <h3>The {moistureCheck.name}</h3>
          <p>
            A separate paid diagnostic service for checking moisture behind the wall before repair.
          </p>
          <span class="card-go">View service</span>
        </a>
      </div>
      </div>
    </section>

    {/* POSITIONING — the argument in short. The full version lives on
        /stucco-repair/; this is the summary that earns the click. */}
    <section class="section band" id="how-we-work">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">How we work</p>
          <h2>Most stucco repairs fail because nobody looked behind the wall</h2>
        </header>

        <div class="prose">
          <p>
            A crack gets filled, sanded, and painted. It looks right for a season,
            then opens again in the same place.
            <strong>
              That&rsquo;s because the crack was never the problem &mdash; it was
              the evidence.
            </strong>
            When water gets behind stucco it doesn&rsquo;t dry out on its own, and
            patching the surface seals it in.
          </p>

          <p>
            Not every crack means water &mdash; hairline cracking is normal in
            Florida. <strong>But you can&rsquo;t tell which is which from the
            outside</strong>, and that&rsquo;s the whole reason the first repair
            failed. If you want to narrow it down yourself first, start with{' '}
            <a href="/problems/cracks-in-stucco/">
              which cracks matter and which don&rsquo;t
            </a>.
          </p>

          <p>
            <a class="more" href="/stucco-repair/">
              More on how we approach a repair and what it costs
            </a>
          </p>
        </div>
      </div>
    </section>

    {/*
      RULING-OUT + OBJECTIONS (2026-09-02).

      voice-profile.md:240 — "Rule things out. At least one place per page where
      work is ruled unnecessary." The cosmetic-cracking concession existed on
      this page but was buried mid-paragraph in "How we work"; it earns nothing
      there. Promoted here to its own callout where it does its job.

      The objections are the three the audience actually holds
      (audience.md — fear of being burned, Stage-3 sophistication, low trust):
      the repeat-repair fear, the cheaper quote, and "why pay to diagnose."
      Each is answered with an argument or a verified fact and nothing else —
      no warranty, no review, no project count, no photo. All four are null.

      NOT INCLUDED, deliberately: any objection whose honest answer requires a
      fact we do not have. "How long will it take" and "what if it fails again"
      both need `warrantyTerms` or a measured timeline. Answering them from
      nothing would be the exact overclaim this positioning is built against.
    */}
    <section class="section objections" id="straight-answers">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">Straight answers</p>
          <h2>Before you call anyone</h2>
        </header>

        <div class="ruling-out">
          <h3>Sometimes the answer is that you don&rsquo;t need us yet</h3>
          <p>
            Hairline cracking is normal in Florida, and not all of it needs
            repairing. When that&rsquo;s what we find, we say so and we
            don&rsquo;t sell you a repair. We would rather tell you the wall is
            fine than find you an expensive problem you don&rsquo;t have.
          </p>
        </div>

        <div class="qa-list">
          <div class="qa">
            <h3>We already had this repaired and it came back</h3>
            <p>
              That is the pattern this whole approach is built around: a repair
              that closes the surface without addressing what caused it. If
              water is getting into the wall, patching over it does not change
              that &mdash; so the crack has the same reason to open again that
              it had the first time.
              {' '}<a href="/blog/why-stucco-cracks-come-back/">
                The long version of why that happens
              </a>{' '}goes through it properly.
            </p>
          </div>

          <div class="qa">
            <h3>Why not just go with the cheaper quote?</h3>
            <p>
              Sometimes you should &mdash; if the wall is sound, the cheaper
              quote is the right quote. The problem is that a patch price and a
              repair price look like the same purchase from the outside, and
              they are not. What separates them is whether anyone established
              what was behind the wall before pricing it. If nobody looked, the
              low number is a guess wearing a price tag.
            </p>
          </div>

          <div class="qa">
            <h3>Why would we pay for a diagnosis on top of the repair?</h3>
            <p>
              Not every job calls for it. The repair estimate is free, and
              where the damage is visible and localized, that estimate can be
              the whole conversation. The
              {' '}{moistureCheck.name} is for when nobody can tell from the
              outside &mdash; a stain that returns, a soft spot, a repair that
              already failed once. Paying for it separately is what keeps the
              answer honest: we get paid the same whether the wall is wet or
              fine.
            </p>
          </div>

          <div class="qa">
            <h3>Do you work on condo and commercial buildings?</h3>
            <p>
              Yes &mdash; we perform commercial and condo stucco work and we are
              licensed and insured for it, including multi-story buildings and
              buildings that stay occupied while we work.
              {' '}<a href="/commercial-stucco/">
                Commercial and condo stucco work
              </a>{' '}covers how that side of it runs.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/*
      THE MOISTURE CHECK — REDUCED TO A SUMMARY (2026-08-30).

      Phase 10 step 6: the full block (3 steps + 5 deliverables + caveat)
      previously rendered here, on /stucco-repair/, and on the now-retired
      /stucco-repair-daytona-beach/. Three full copies of the same content.

      DONE 2026-08-30: /stucco-moisture-testing/ was built and now holds the
      full detail. /stucco-repair/#moisture-check reduced to a summary at the
      same time, and this link was repointed to the new page. This section
      stays a summary — do not re-expand it.

      The price and the free-estimate separation stay stated here: per
      positioning.md that separation is a hard constraint wherever the Check is
      mentioned, and a summary must not blur it.
    */}
    <section class="section" id="moisture-check">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">A paid diagnostic service</p>
          <h2>The {moistureCheck.name}</h2>
        </header>

        <div class="prose">
          <p>
            Before anyone quotes you a repair, it&rsquo;s worth knowing whether
            there&rsquo;s moisture behind the wall. That&rsquo;s a separate piece
            of work from the repair, and it&rsquo;s what the
            {' '}{moistureCheck.name} is: a visual examination, moisture meter
            testing, and thermal imaging when it&rsquo;s appropriate. You get the
            findings, the readings, and what we&rsquo;d do next &mdash; whether or
            not you ever hire us.
          </p>

          <p>
            It costs ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}
            {' '}and is <strong>not</strong> included in the free repair estimate.
          </p>

          <p>
            <a class="more" href="/stucco-moisture-testing/">
              The full process, what the readings mean, and what it costs
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* PRICING */}
    <section class="section band" id="pricing">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">What it costs</p>
          <h2>Two prices, and they are not the same thing</h2>
        </header>

        <div class="prices grid-hairline">
          <div class="price-card">
            <p class="price-label">Repair estimate</p>
            <p class="price-figure">Free</p>
            <p class="price-body">
              If you know what you need done, we&rsquo;ll come look at it and
              give you a number for the work. No charge for that.
            </p>
          </div>

          <div class="price-card featured">
            <p class="price-label">{moistureCheck.name}</p>
            <p class="price-figure">
              ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}
            </p>
            <p class="price-body">
              {whatMovesThePrice
                ? whatMovesThePrice
                : `A paid diagnostic service, priced ${moistureCheck.priceNote}.`}
            </p>
          </div>
        </div>

        {/*
          The market-range excerpt. Four of nine rows — see the cannibalization
          guard in the frontmatter before touching this.
        */}
        <div class="ranges">
          <h3>What stucco repair runs in this area</h3>

          <ul class="range-list">
            {priceExcerpt.map((row) => (
              <li>
                <span class="range-job">{row.job}</span>
                <span class="range-num">
                  {money(row.low)}&ndash;{money(row.high)}{row.openEnded ? '+' : ''}
                </span>
              </li>
            ))}
          </ul>

          <p class="range-psf">
            Roughly {money(repairPerSquareFoot.low)}&ndash;{money(repairPerSquareFoot.high)}
            {' '}per square foot, {repairPerSquareFoot.note}.
          </p>

          <p class="range-note">{pricingDisclaimer}</p>

          <p>
            <a class="more" href="/stucco-repair/#pricing">
              The full range table and what moves the number
            </a>
          </p>
        </div>

        <div class="separation">
          <h3>These are two different things, and we&rsquo;ll be plain about it</h3>
          <p>
            The estimate is free. The {moistureCheck.name} is not &mdash; it&rsquo;s
            ${moistureCheck.priceLow}&ndash;${moistureCheck.priceHigh}, paid on its
            own. <strong>It isn&rsquo;t credited toward repair work if you hire
            us.</strong> If we do the repair, that&rsquo;s quoted and paid
            separately.
          </p>
          <p>
            We charge for it for a reason. Because the fee isn&rsquo;t tied to
            winning your repair job, we get paid the same whether the answer is
            &ldquo;there&rsquo;s water in this wall&rdquo; or &ldquo;this is
            cosmetic, leave it alone.&rdquo;
            <strong>
              Nobody here has a reason to find you an expensive problem.
            </strong>
          </p>
        </div>
      </div>
    </section>

    {/*
      SERVICE AREA. The old "More on the work" list lived here and duplicated
      the services index above, including a link to the retired
      /stucco-repair-daytona-beach/. Replaced 2026-08-30 with the area
      statement, which is what this slot is actually for on an entity page.

      Now sits on the dark band, mirroring the reference's local-conditions
      section, which is the same job: what this specific place does to the
      material.
    */}
    <section class="section area on-dark" id="area">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">Where we work</p>
          <h2>Volusia County and Orange County, Florida</h2>
        </header>

        <div class="prose">
