  /* --- Keyboard focus --------------------------------------------------
   * Added 2026-09-03. There was no focus style anywhere in the global
   * layer: only LeadForm and the contact page styled their own fields, and
   * SiteHeader styled its dropdown items. Every other link and button -
   * the whole nav, every .btn, every .card-link, the footer, the mobile
   * sticky bar - fell back to the UA default outline, which is a thin dark
   * ring. On the --shell dark bands (header, hero, footer, CTA) that ring
   * is very nearly invisible, so a keyboard user could not tell where they
   * were. WCAG 2.4.7.
   *
   * :focus-visible, not :focus, so the ring appears for keyboard and
   * programmatic focus but not on mouse click - which is why no existing
   * mouse interaction changes appearance.
   *
   * outline-offset is positive so the ring sits clear of the element's own
   * 2px border (.btn) and 1px box-shadow seams (.grid-hairline cells)
   * rather than merging with them. Outline does not affect layout, so
   * nothing shifts and no existing spacing changes. */
  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* On dark bands the accent orange is too close to the ground to read as
   * a ring, so the light band ink is used instead. Same geometry. */
  .on-dark :focus-visible {
    outline-color: var(--shell-ink);
  }

  /* The sticky bar's primary button already paints --accent as its own
   * ground; an accent ring on top of it would disappear. */
  .s-primary:focus-visible {
    outline-color: var(--shell-ink);
  }
