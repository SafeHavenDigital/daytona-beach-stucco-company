---
import { business } from '../config/site';

interface Props {
  title: string;
  description: string;
  /**
   * Override the canonical path. Only needed when a page should point at a
   * different URL than its own — none currently do. Consolidated pages are
   * handled by 301s in astro.config.mjs, not by cross-canonicals, because a
   * redirect is the stronger and less ambiguous signal.
   */
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;

/**
 * Self-referencing canonical.
 *
 * Emitted as a root-relative path rather than an absolute URL because no
 * production domain has been supplied yet (`astro.config.mjs` has no `site`,
 * and src/config/site.ts holds no domain). Per the verification rule in
 * site.ts, inventing one is not an option — a guessed domain in a canonical
 * would actively misdirect crawlers, which is worse than omitting it.
 *
 * Root-relative canonicals are valid and resolve against the served origin, so
 * this is correct on any domain. When the real domain is supplied, set `site`
 * in astro.config.mjs and change this to `new URL(path, Astro.site)` to emit
 * absolute canonicals, which are marginally preferred.
 *
 * Trailing slash is normalized to match the built URLs (Astro's default
 * directory-style output), so the canonical never disagrees with the address
 * the page is actually served at.
 */
const rawPath = canonicalPath ?? Astro.url.pathname;
const canonical =
  rawPath === '/' ? '/' : rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1d1f;
    --ink-soft: #4a5157;
    --ink-faint: #6b7378;
    --rule: #e2e0dc;
    --paper: #ffffff;
    --paper-warm: #f7f5f1;
    --sand: #efe9df;
    --accent: #1f4e5f;
    --accent-deep: #163a47;
    --flag: #8a5a2b;
    --measure: 34rem;
    --gutter: clamp(1.25rem, 5vw, 2.5rem);
    --section-y: clamp(3rem, 8vw, 5.5rem);
  }

  * { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }

  h1 { font-size: clamp(2rem, 6vw, 3.25rem); }
  h2 { font-size: clamp(1.5rem, 4vw, 2.125rem); }
  h3 { font-size: clamp(1.125rem, 2.5vw, 1.3125rem); }

  p { margin: 0 0 1.125rem; max-width: var(--measure); }

  a { color: var(--accent); }

  strong { font-weight: 650; }

  .wrap {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .section { padding-block: var(--section-y); }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
    margin: 0 0 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
